# Google GenAI (Gemini) API key - required
GEMINI_API_KEY=your_gemini_api_key_here

# Application environment: development | staging | production
APP_ENV=development

# Port the Uvicorn server binds to
PORT=8000

# Default model used for story generation
DEFAULT_MODEL=gemini-3.6-flash

# Cloudflare Workers AI (used for cover image generation, since Gemini's
# free tier does not currently include image-generation quota).
# Get these from the Cloudflare dashboard: Account ID is on the right
# sidebar of any zone/account overview page. API token: My Profile ->
# API Tokens -> Create Token -> "Workers AI" template (needs Workers AI
# Read/Edit permission). Free tier: 10,000 neurons/day, no credit card.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Workers AI model used for cover image generation
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
